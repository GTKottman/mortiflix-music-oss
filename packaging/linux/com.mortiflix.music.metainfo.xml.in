<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.mortiflix.music</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Mortiflix Music</name>
  <summary>Make a song with AI, stage by stage, and take it home as MIDI</summary>
  <developer id="com.mortiflix">
    <name>Mortiflix</name>
  </developer>
  <description>
    <p>
      Mortiflix Music walks a song from an idea to MIDI files in nine stages: idea, genre, song map, chords, shapes,
      melody, arrange, feel and export. The AI makes the musical decisions and the app writes and checks every note,
      so each stage is played, checked and approved before the next one starts. Out come a whole-song MIDI file, one
      per part and one per section, steps for FL Studio and REAPER, and a General MIDI preview. It is built on an
      open-source video editor by Learning Machines LLC (MIT OR Apache-2.0), whose notices and credits it keeps.
    </p>
  </description>
  <launchable type="desktop-id">com.mortiflix.music.desktop</launchable>
  <icon type="stock">com.mortiflix.music</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://mortiflix.com</url>
  <url type="bugtracker">https://mortiflix.com</url>
  <url type="help">https://mortiflix.com</url>
  <url type="contact">https://discord.gg/5xCB666rYk</url>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Midi</category>
  </categories>
  <keywords>
    <keyword>music</keyword>
    <keyword>midi</keyword>
    <keyword>song</keyword>
    <keyword>composer</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>mortiflix-music</binary>
    <mediatype>application/x-mortiflix-music</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
