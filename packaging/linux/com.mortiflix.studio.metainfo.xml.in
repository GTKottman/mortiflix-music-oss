<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.mortiflix.studio</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Mortiflix Studio</name>
  <summary>Make a video with AI step by step, then edit and render it</summary>
  <developer id="com.mortiflix">
    <name>Mortiflix</name>
  </developer>
  <description>
    <p>
      Mortiflix Studio walks you through a video with node-based AI generation, then opens it in a full
      video editor with every piece placed, ready for final edits and the render. It is built on an open-source video editor by
      Learning Machines LLC (MIT OR Apache-2.0), whose notices and credits it keeps.
    </p>
  </description>
  <launchable type="desktop-id">com.mortiflix.studio.desktop</launchable>
  <icon type="stock">com.mortiflix.studio</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://mortiflix.com</url>
  <url type="bugtracker">https://mortiflix.com</url>
  <url type="help">https://mortiflix.com</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>AudioVideoEditing</category>
  </categories>
  <keywords>
    <keyword>video</keyword>
    <keyword>video editor</keyword>
    <keyword>timeline</keyword>
    <keyword>color grading</keyword>
    <keyword>nle</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>mortiflix-studio</binary>
    <mediatype>application/x-mortiflix-studio</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
