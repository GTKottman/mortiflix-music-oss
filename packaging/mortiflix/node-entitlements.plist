<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the Node runtime in the Mortiflix bundle
     (Mortiflix Studio.app/Contents/Resources/mortiflix/node/bin/node), re-signed by packaging/macos/package.sh.
     V8 compiles JavaScript at run time, so Node needs JIT and writable-executable memory; these are the
     entitlements Node's own macOS release builds are signed with. Nothing else in the app gets them. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-executable-page-protection</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
